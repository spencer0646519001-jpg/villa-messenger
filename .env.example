LINE_TEST_CHANNEL_ID=
LINE_TEST_CHANNEL_SECRET=
LINE_TEST_CHANNEL_ACCESS_TOKEN=
LINE_TEST_OWNER_USER_ID=

OPENROUTER_API_KEY=sk-or-...
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek/deepseek-v4-flash
LLM_TIMEOUT_SECONDS=12

# Optional LLM-layer fallback: primary LLM -> fallback LLM -> rule-based parser.
# Keep disabled until you have verified fallback behavior in tests/staging.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_TIMEOUT_SECONDS=8

# Google Calendar availability gate. Keep false until local/staging verification
# is complete; true enables live calendar checks before quote replies.
GOOGLE_CALENDAR_AVAILABILITY_ENABLED=false

# Required only when GOOGLE_CALENDAR_AVAILABILITY_ENABLED=true.
# Calendar ID env var referenced by data/tenants/zhen123-house/config.json.
ZHEN123_CALENDAR_ID=

# Required only when GOOGLE_CALENDAR_AVAILABILITY_ENABLED=true.
# Absolute or app-relative path to the Google service-account JSON file.
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# OpenRouter model id reference, checked against the official models endpoint:
# DeepSeek primary: deepseek/deepseek-v4-flash
# GPT-4o-mini eval/backup: openai/gpt-4o-mini
